MOCK_FEEDS=1
RIDEEDGE_PUBLIC_ORIGIN=https://rideedge.example.com
# Dashboard bind. Default is loopback: RDP into workstation, then open
# http://127.0.0.1:8787. FAROL_HOST=tailscale binds only the Tailscale IPv4.
# Do not set 0.0.0.0 unless you also set FAROL_ALLOW_PUBLIC_BIND=1.
FAROL_HOST=127.0.0.1
FAROL_PORT=8787
FAROL_HTTP_USER_AGENT=farol/0.1 (local driving copilot)
FAROL_CACHE_DIR=
FAROL_NWS_HOURLY_URL=
FAROL_DB=farol.db
VEHICLE_COST_PER_MILE=0.30
VALUE_OF_TIME_PER_HOUR=25.00
FAROL_CAR_TOKEN=
# Qwen handles AI while browsing and driving. No cloud AI fallback.
# Historical Grok adapters require explicit FAROL_BRAIN=grok to run.
# Optional shared event store; populated by beast/event-calendar.ps1, read locally by RideEdge.
# FAROL_EVENTS_DIR=C:\intelraker\raked\seattle-events
FAROL_BRAIN=qwen
FAROL_GROK_MODEL=grok-4.6
FAROL_GROK_TTL_SECONDS=1200
FAROL_GROK_TIMEOUT_SECONDS=90
FAROL_GROK_REASONING=low
FAROL_GROK_BRAIN_REASONING=high
FAROL_GROK_BLOCK=
FAROL_GROK_IN_MOCK=
# Local Qwen: short on-demand GPU loans while browsing; retained during a shift.
# Other applications' leases are never reclaimed. "external" uses an already
# running loopback server without any model/process/lease management.
FAROL_LOCAL_MANAGE=external
# Profiles and exact model/runtime paths: beast/local-models.json.
FAROL_LOCAL_PROFILE=qwen
FAROL_LOCAL_URL=http://127.0.0.1:1234/v1/chat/completions
# Must exactly match /v1/models; the Qwen-only path rejects other model families.
FAROL_LOCAL_MODEL=qwen3.8-27b
# Optional local CPU speech. Model must already exist in the Hugging Face cache.
# Install package extra [voice]; Windows installed English voice supplies playback.
FAROL_VOICE_MODEL=base.en
WSDOT_API_KEY=
ONEBUSAWAY_API_KEY=
TICKETMASTER_API_KEY=
# Discovery event search uses the consumer key only. Secret is unused.
TICKETMASTER_SECRET=
SEATGEEK_CLIENT_ID=
# Public event search uses client_id only. Secret is unused.
SEATGEEK_SECRET=
# Places API (New) + Routes API. Server-side on workstation only; never put this in a browser.
GOOGLE_MAPS_API_KEY=
# AeroAPI Personal. On-demand only: HERE at SEA / SEA FIFO button. Not collected.
FLIGHTAWARE_API_KEY=
# BestTime coverage pilot only: explicit CLI requests, no scheduled collection.
BESTTIME_API_KEY_PRIVATE=
BESTTIME_API_KEY_PUBLIC=
